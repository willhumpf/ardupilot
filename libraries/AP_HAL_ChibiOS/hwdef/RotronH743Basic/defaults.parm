# Defaults for Rotron H743 Basic

# B-DSHOT and MOTORS (Dshot300 Bidir)
MOT_PWM_TYPE 5
MOT_PWM_MIN 1000
MOT_PWM_MAX 2000
SERVO1_FUNCTION 33
SERVO2_FUNCTION 34
SERVO3_FUNCTION 35
SERVO4_FUNCTION 36
SERVO_BLH_MASK 15
SERVO_BLH_POLES 14
SERVO_DSHOT_ESC 3
SERVO_BLH_BDMASK 15
SERVO_BLH_AUTO 1

# RFD Serial Settings
SERIAL1_BAUD 57
SERIAL1_OPTIONS 0
SERIAL1_PROTOCOL 2

# GPS Serial
SERIAL3_BAUD 230
SERIAL3_OPTIONS 0
SERIAL3_PROTOCOL 5

# Frame 
FRAME_CLASS 1
FRAME_TYPE 18

# Battery
MOT_BAT_VOLT_MAX 25.2
MOT_BAT_VOLT_MIN 19.8

# Motor Buzzer
NTS_BUZZ_TYPES 2
